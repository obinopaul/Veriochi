# -----------------------------
# Core
# -----------------------------
SECRET_KEY="__REPLACE_WITH_STRONG_RANDOM_SECRET__"
DEBUG=0
ALLOWED_HOSTS="example.com"
APP_DOMAIN="example.com"
APP_RELEASE="stable"
API_BASE_URL="https://api.example.com"
WEB_URL="https://app.example.com"
CORS_ALLOWED_ORIGINS="https://app.example.com,https://admin.example.com"

# -----------------------------
# Database (Postgres)
# -----------------------------
DATABASE_URL="postgresql://plane:plane@plane-db:5432/plane"
POSTGRES_HOST="plane-db"
POSTGRES_PORT="5432"
POSTGRES_DB="plane"
POSTGRES_USER="plane"
POSTGRES_PASSWORD="plane"
PGDATA="/var/lib/postgresql/data"
ENABLE_READ_REPLICA=0
DATABASE_READ_REPLICA_URL=""
POSTGRES_READ_REPLICA_HOST=""
POSTGRES_READ_REPLICA_PORT="5432"
POSTGRES_READ_REPLICA_DB=""
POSTGRES_READ_REPLICA_USER=""
POSTGRES_READ_REPLICA_PASSWORD=""

# -----------------------------
# Redis
# -----------------------------
REDIS_URL="redis://plane-redis:6379/0"
REDIS_HOST="plane-redis"
REDIS_PORT="6379"

# -----------------------------
# RabbitMQ / Celery broker
# -----------------------------
AMQP_URL="amqp://plane:plane@plane-mq:5672/plane"
RABBITMQ_HOST="plane-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="plane"

# -----------------------------
# Object storage (MinIO / S3)
# -----------------------------
USE_MINIO=1
MINIO_ENDPOINT_URL="http://plane-minio:9000"
MINIO_ENDPOINT_SSL=0
AWS_S3_ENDPOINT_URL="http://plane-minio:9000"
AWS_S3_BUCKET_NAME="uploads"
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_REGION="us-east-1"

# -----------------------------
# Application URLs and routing
# -----------------------------
SITE_ADDRESS=:80
TRUSTED_PROXIES=0.0.0.0/0
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443
ADMIN_BASE_URL="https://admin.example.com"
ADMIN_BASE_PATH="/god-mode/"
SPACE_BASE_URL="https://spaces.example.com"
SPACE_BASE_PATH="/spaces/"
APP_BASE_URL="https://app.example.com"
APP_BASE_PATH="/"
LIVE_BASE_URL="https://live.example.com"
LIVE_BASE_PATH="/live/"
LIVE_SERVER_SECRET_KEY="__REPLACE_LIVE_SECRET__"
HARD_DELETE_AFTER_DAYS=60
INSTANCE_CHANGELOG_URL=""

# -----------------------------
# Email and login providers
# -----------------------------
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_HOST_USER="send@example.com"
EMAIL_HOST_PASSWORD="__REPLACE_EMAIL_PASSWORD__"
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_FROM="Plane <notifications@example.com>"
EMAIL_BACKEND="django.core.mail.backends.smtp.EmailBackend"
ENABLE_SMTP=1
ENABLE_EMAIL_PASSWORD=0
ENABLE_MAGIC_LINK_LOGIN=1
ENABLE_SIGNUP=1
DISABLE_WORKSPACE_CREATION=0

# -----------------------------
# Session / cookies
# -----------------------------
SESSION_COOKIE_AGE=604800
SESSION_COOKIE_NAME="session-id"
SESSION_SAVE_EVERY_REQUEST=0
ADMIN_SESSION_COOKIE_AGE=3600
COOKIE_DOMAIN="example.com"

# -----------------------------
# Uploads and limits
# -----------------------------
FILE_SIZE_LIMIT=5242880
UNUPLOADED_ASSET_DELETE_DAYS=7

# -----------------------------
# Runtime tuning
# -----------------------------
PORT=8000
GUNICORN_WORKERS=4

# -----------------------------
# Third-party integrations
# -----------------------------
POSTHOG_API_KEY=""
POSTHOG_HOST=""
UNSPLASH_ACCESS_KEY=""
GITHUB_ACCESS_TOKEN=""
GITHUB_APP_NAME="Veriochi"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_ORGANIZATION_ID=""
GITLAB_HOST="https://gitlab.com"
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ANALYTICS_SECRET_KEY=""
ANALYTICS_BASE_API=""
SCOUT_MONITOR=0
SCOUT_KEY=""
SLACK_CLIENT_ID=""
IS_GOOGLE_ENABLED=0
IS_GITHUB_ENABLED=0
IS_GITLAB_ENABLED=0
IS_INTERCOM_ENABLED=0
INTERCOM_APP_ID=""
MONGO_DB_URL=""
MONGO_DB_DATABASE=""
ENABLE_DRF_SPECTACULAR=0

# -----------------------------
# LLM settings
# -----------------------------
LLM_PROVIDER="openai"
LLM_MODEL="gpt-4o-mini"
LLM_API_KEY=""

# -----------------------------
# AI / GPT (deprecated)
# -----------------------------
OPENAI_API_BASE="https://api.openai.com/v1"
OPENAI_API_KEY="sk-"
GPT_ENGINE="gpt-3.5-turbo"

# -----------------------------
# Deployment helpers
# -----------------------------
DOCKERIZED=1
DOCKER_PLATFORM=""
SKIP_ENV_VAR=1
IS_TEST=0
APP_VERSION="2025.11.01"

# -----------------------------
# Deployment scaling (docker-compose templates)
# -----------------------------
WEB_REPLICAS=1
ADMIN_REPLICAS=1
API_REPLICAS=1
WORKER_REPLICAS=1
BEAT_WORKER_REPLICAS=1

# -----------------------------
# Certificates / TLS
# -----------------------------
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_EMAIL="ops@example.com"
CERT_ACME_DNS=""

# -----------------------------
# API key rate limit
# -----------------------------
API_KEY_RATE_LIMIT="60/minute"

# -----------------------------
# Telemetry
# -----------------------------
SERVICE_NAME="veriochi-api"
OTLP_ENDPOINT="https://telemetry.plane.so"
